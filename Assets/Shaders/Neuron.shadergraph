    },
    "m_Slots": [
        {
            "m_Id": "ae4936c2cafc4e58b871ce730bec8d9b"
        },
        {
            "m_Id": "7ccd3e7efb6f4b0595b84f2c87460d1e"
        },
        {
            "m_Id": "abddb67bd7dd4d9ea67ef92fc4b24e1f"
        },
        {
            "m_Id": "a7b71e2af7804c579b98054d2828345b"
        },
        {
            "m_Id": "13df3a3f044f409b99725669035033ad"
        },
        {
            "m_Id": "c841652ec11749cb9b8412b179fdf702"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Trapezoidal",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "   if (X <= A || X >= D) {\r\n       Out = 0.0;\r\n   } else if (X < B) {\r\n       Out = (B > A) ? (X - A) / (B - A) : 1.0;\r\n   } else if (X <= C) {\r\n       Out = 1.0;\r\n   } else {\r\n       Out = (D > C) ? (D - X) / (D - C) : 1.0;\r\n   }"
}

