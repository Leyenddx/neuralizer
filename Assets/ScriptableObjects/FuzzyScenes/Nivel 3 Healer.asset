MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3bb567751d5a964e8b5a825b0724e4d, type: 3}
  m_Name: Nivel 3 Healer
  m_EditorClassIdentifier: Neuralizer::Neuralizer.Data.FuzzyScene
  displayName: El Dilema del Healer
  storageName: m2_nivel3_healer
  scoreboardID: 
  minTime: 15
  minMaxScores: {x: 1, y: 10}
  successThreshold: 0.95
  narrativeContext: "Dos aliados en cr\xEDtico. \xBFA qui\xE9n curas primero? Tu IA de healer ignora una regla clave. Ajusta el peso de las reglas para que cure primero a quien corre m\xE1s riesgo."
  system:
    inputs:
    - variableName: HP
      range: {x: 0, y: 100}
      labels:
      - label: Bajo
        membership:
          shape: 0
          a: 0
          b: 0
          c: 30
          d: 55
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
      - label: Alto
        membership:
          shape: 0
          a: 35
          b: 70
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
    - variableName: "Da\xF1oEntrante"
      range: {x: 0, y: 100}
      labels:
      - label: Bajo
        membership:
          shape: 0
          a: 0
          b: 0
          c: 30
          d: 50
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
      - label: Alto
        membership:
          shape: 0
          a: 30
          b: 70
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
    outputs:
    - variableName: Prioridad
      range: {x: 0, y: 100}
      labels:
      - label: Baja
        membership:
          shape: 0
          a: 0
          b: 0
          c: 25
          d: 50
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
      - label: Media
        membership:
          shape: 0
          a: 25
          b: 50
          c: 50
          d: 75
          center: 0
          spread: 1
        displayColor: {r: 0.61, g: 0.36, b: 1, a: 1}
      - label: Alta
        membership:
          shape: 0
          a: 50
          b: 75
          c: 75
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
      - label: MuyAlta
        membership:
          shape: 0
          a: 75
          b: 90
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 1, g: 0.3, b: 0.43, a: 1}
    rules:
    - description: "SI HP es Bajo Y Da\xF1oEntrante es Alto ENTONCES Prioridad es MuyAlta"
      conditions:
      - inputIndex: 0
        label: Bajo
      - inputIndex: 1
        label: Alto
      combineWith: 0
      outputIndex: 0
      outputLabel: MuyAlta
      weight: 0
    - description: "SI HP es Bajo Y Da\xF1oEntrante es Bajo ENTONCES Prioridad es Alta"
      conditions:
      - inputIndex: 0
        label: Bajo
      - inputIndex: 1
        label: Bajo
      combineWith: 0
      outputIndex: 0
      outputLabel: Alta
      weight: 1
    - description: SI HP es Alto ENTONCES Prioridad es Baja
      conditions:
      - inputIndex: 0
        label: Alto
      combineWith: 0
      outputIndex: 0
      outputLabel: Baja
      weight: 1
