  m_Name: Nivel 1 Economia
  m_EditorClassIdentifier: Neuralizer::Neuralizer.Data.FuzzyScene
  displayName: "Econom\xEDa de Equipo"
  storageName: m2_nivel1_economia
  scoreboardID: 
  minTime: 15
  minMaxScores: {x: 1, y: 10}
  successThreshold: 0.95
  narrativeContext: "\xBFQu\xE9 tan preparado est\xE1 tu equipo para esta ronda? El coach clasifica el dinero del equipo en Eco, SemiBuy o FullBuy, pero sus curvas est\xE1n mal calibradas. Aj\xFAstalas para que cada ronda quede en la categor\xEDa correcta."
  system:
    inputs:
    - variableName: Dinero
      range: {x: 0, y: 16000}
      labels:
      - label: Eco
        membership:
          shape: 0
          a: 0
          b: 0
          c: 4000
          d: 7000
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
      - label: SemiBuy
        membership:
          shape: 0
          a: 4000
          b: 7000
          c: 9000
          d: 12000
          center: 0
          spread: 1
        displayColor: {r: 0.61, g: 0.36, b: 1, a: 1}
      - label: FullBuy
        membership:
          shape: 0
          a: 9000
          b: 12000
          c: 16000
          d: 16000
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
    outputs: []
    rules: []
  cases:
  - label: Pistola
    inputValues:
    - 1500
    expectedRank: 0
    expectedLabel: Eco
  - label: Bonus
    inputValues:
    - 4200
    expectedRank: 0
    expectedLabel: SemiBuy
  - label: Force
