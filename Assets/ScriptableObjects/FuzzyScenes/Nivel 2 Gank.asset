%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3bb567751d5a964e8b5a825b0724e4d, type: 3}
  m_Name: Nivel 2 Gank
  m_EditorClassIdentifier: Neuralizer::Neuralizer.Data.FuzzyScene
  displayName: Prioridad de Gank
  storageName: m2_nivel2_gank
  scoreboardID: 
  minTime: 15
  minMaxScores: {x: 1, y: 10}
  successThreshold: 0.95
  narrativeContext: "SI una l\xEDnea est\xE1 perdiendo, ENTONCES gankea ah\xED. El jungla deber\xEDa priorizar Top > Mid > Bot, pero la etiqueta \"Parejo\" es tan ancha que todo le parece igual. Corrige las curvas de DesventajaDeOro."
  system:
    inputs:
    - variableName: DesventajaDeOro
      range: {x: -3000, y: 3000}
      labels:
      - label: Perdiendo
        membership:
          shape: 0
          a: -3000
          b: -3000
          c: -2800
          d: -2400
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
      - label: Parejo
        membership:
          shape: 0
          a: -2800
          b: -2000
          c: 2000
          d: 2800
          center: 0
          spread: 1
        displayColor: {r: 0.61, g: 0.36, b: 1, a: 1}
      - label: Ganando
        membership:
          shape: 0
          a: 2400
          b: 2800
          c: 3000
          d: 3000
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
    outputs:
    - variableName: PrioridadGank
      range: {x: 0, y: 100}
      labels:
      - label: Baja
        membership:
          shape: 0
          a: 0
          b: 0
          c: 25
          d: 50
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
      - label: Media
        membership:
          shape: 0
          a: 25
          b: 50
          c: 50
          d: 75
          center: 0
          spread: 1
        displayColor: {r: 0.61, g: 0.36, b: 1, a: 1}
      - label: Alta
        membership:
          shape: 0
          a: 50
          b: 75
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
    rules:
    - description: SI DesventajaDeOro es Perdiendo ENTONCES PrioridadGank es Alta
      conditions:
      - inputIndex: 0
        label: Perdiendo
      combineWith: 0
      outputIndex: 0
      outputLabel: Alta
      weight: 1
    - description: SI DesventajaDeOro es Parejo ENTONCES PrioridadGank es Media
      conditions:
      - inputIndex: 0
        label: Parejo
      combineWith: 0
      outputIndex: 0
      outputLabel: Media
      weight: 1
    - description: SI DesventajaDeOro es Ganando ENTONCES PrioridadGank es Baja
      conditions:
      - inputIndex: 0
        label: Ganando
      combineWith: 0
      outputIndex: 0
      outputLabel: Baja
      weight: 1
  cases:
  - label: Bot
    inputValues:
    - 1200
    expectedRank: 2
    expectedLabel: 
  - label: Mid
    inputValues:
    - 0
    expectedRank: 1
    expectedLabel: 
  - label: Top
    inputValues:
    - -1800
    expectedRank: 0
    expectedLabel: 
  mode: 0
  editableRuleWeights: 0
  editableMemberships: 1
  showControlSurface: 0
