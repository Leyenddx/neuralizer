          shape: 0
          a: 75
          b: 90
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 1, g: 0.3, b: 0.43, a: 1}
    rules:
    - description: SI VidaRestante es Baja Y Amenaza es Alta ENTONCES PrioridadObjetivo es MuyAlta
      conditions:
      - inputIndex: 0
        label: Baja
      - inputIndex: 1
        label: Alta
      combineWith: 0
      outputIndex: 0
      outputLabel: MuyAlta
      weight: 0
    - description: SI VidaRestante es Baja Y Amenaza es Baja ENTONCES PrioridadObjetivo es Media
      conditions:
      - inputIndex: 0
        label: Baja
      - inputIndex: 1
        label: Baja
      combineWith: 0
      outputIndex: 0
      outputLabel: Media
      weight: 1
    - description: SI VidaRestante es Alta Y Amenaza es Alta ENTONCES PrioridadObjetivo es Alta
      conditions:
      - inputIndex: 0
        label: Alta
      - inputIndex: 1
        label: Alta
      combineWith: 0
      outputIndex: 0
      outputLabel: Alta
      weight: 1
