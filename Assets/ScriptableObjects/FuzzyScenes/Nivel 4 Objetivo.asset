  successThreshold: 0.95
  narrativeContext: "Focus fire: \xBFa qui\xE9n ataca primero el equipo? Hoy el equipo ignora a los enemigos fr\xE1giles pero peligrosos. Ajusta las reglas y mira c\xF3mo cambia la superficie de control."
  system:
    inputs:
    - variableName: VidaRestante
      range: {x: 0, y: 100}
      labels:
      - label: Baja
        membership:
          shape: 0
          a: 0
          b: 0
          c: 30
          d: 50
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
      - label: Alta
        membership:
          shape: 0
          a: 30
          b: 70
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
    - variableName: Amenaza
      range: {x: 0, y: 100}
      labels:
      - label: Baja
        membership:
          shape: 0
          a: 0
          b: 0
          c: 30
          d: 50
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
      - label: Alta
        membership:
          shape: 0
          a: 30
          b: 70
          c: 100
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
    outputs:
    - variableName: PrioridadObjetivo
      range: {x: 0, y: 100}
      labels:
      - label: Baja
        membership:
          shape: 0
          a: 0
          b: 0
          c: 25
          d: 50
          center: 0
          spread: 1
        displayColor: {r: 0.18, g: 0.77, b: 1, a: 1}
      - label: Media
        membership:
          shape: 0
          a: 25
          b: 50
          c: 50
          d: 75
          center: 0
          spread: 1
        displayColor: {r: 0.61, g: 0.36, b: 1, a: 1}
      - label: Alta
        membership:
          shape: 0
          a: 50
          b: 75
          c: 75
          d: 100
          center: 0
          spread: 1
        displayColor: {r: 0.85, g: 0.3, b: 0.38, a: 1}
      - label: MuyAlta
